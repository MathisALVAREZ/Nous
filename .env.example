# Comptes créés au tout premier démarrage (ignoré ensuite). Format : identifiant:Prénom:motdepasse;identifiant:Prénom:motdepasse
# Le premier compte apparaît à gauche dans l'app. Changez les mots de passe depuis Réglages après la première connexion.
INIT_USERS=mathis:Mathis:CHANGE-MOI-1234;morgane:Morgane:CHANGE-MOI-5678
# Adresse de contact transmise aux services de notification (obligatoire pour le push)
VAPID_SUBJECT=mailto:contact@kratox.fr
# Adresse publique de l'app (sert aux liens envoyés par e-mail)
APP_URL=https://morgane.kratox.fr
# Mot de passe oublié par e-mail (Brevo). Sans ces lignes, la récupération par e-mail est simplement désactivée.
# Clé SMTP : Brevo → SMTP & API → onglet SMTP → « Générer une nouvelle clé SMTP » (une clé dédiée à Nous, révocable).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=identifiant-smtp-brevo@smtp-brevo.com
SMTP_PASS=cle-smtp-brevo
# L'expéditeur doit être sur un domaine authentifié chez Brevo
MAIL_FROM=Nous <nous@abyssia.kratox.fr>
