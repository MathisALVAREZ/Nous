# Comptes créés au tout premier démarrage (ignoré ensuite). Format : identifiant:Prénom:motdepasse;identifiant:Prénom:motdepasse
# Le premier compte apparaît à gauche dans l'app. Changez les mots de passe depuis Réglages après la première connexion.
INIT_USERS=mathis:Mathis:CHANGE-MOI-1234;morgane:Morgane:CHANGE-MOI-5678
# Adresse de contact transmise aux services de notification (obligatoire pour le push)
VAPID_SUBJECT=mailto:contact@kratox.fr
